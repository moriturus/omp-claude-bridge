{
	"name": "omp-claude-bridge",
	"version": "0.10.0",
	"private": false,
	"description": "Oh My Pi extension that runs Claude Code through the official Claude Agent SDK as a model provider and AskClaude delegation tool.",
	"keywords": [
		"omp-package",
		"oh-my-pi",
		"extension",
		"claude-code",
		"claude-agent-sdk"
	],
	"author": "Jonathan Borgwing (https://github.com/DevVig)",
	"contributors": [
		"Eli Dickinson (original pi-claude-bridge author, https://github.com/elidickinson)"
	],
	"license": "MIT",
	"homepage": "https://github.com/DevVig/omp-claude-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevVig/omp-claude-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/DevVig/omp-claude-bridge/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig.json",
		"assets",
		"claude-bridge.example.json"
	],
	"scripts": {
		"test": "node --import tsx --test tests/unit-*.mjs && bun test ./tests/provider-orphan.test.ts",
		"test:unit": "node --import tsx --test tests/unit-*.mjs",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.329",
		"@anthropic-ai/sdk": "^1.11.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"cc-session-io": "^0.4.1",
		"change-case": "^5.4.4",
		"typebox": "^1.4.7",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": ">=19.0.1",
		"@oh-my-pi/pi-ai": ">=19.0.1",
		"@oh-my-pi/pi-coding-agent": ">=19.0.1",
		"@oh-my-pi/pi-tui": ">=19.0.1",
		"@oh-my-pi/pi-utils": ">=19.0.1"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-agent-core": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"devDependencies": {
		"@oh-my-pi/pi-agent-core": "^19.0.1",
		"@oh-my-pi/pi-ai": "^19.0.1",
		"@oh-my-pi/pi-coding-agent": "^19.0.1",
		"@oh-my-pi/pi-tui": "^19.0.1",
		"@oh-my-pi/pi-utils": "^19.0.1",
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"esbuild"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
